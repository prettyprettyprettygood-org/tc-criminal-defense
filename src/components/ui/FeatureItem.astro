---
interface Props {
  title: string;
  href?: string;
  class?: string;
}

const { title, href, class: className = '' } = Astro.props;

const itemClass = `feature-item ${href ? 'feature-item--linked' : ''} ${className}`.trim();
---

<li class={itemClass}>
  {
    href ? (
      <a href={href} class="feature-item-surface">
        <span class="feature-item-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
        <div class="feature-item-body">
          <p class="feature-item-title">{title}</p>
          <div class="feature-item-description">
            <slot />
          </div>
        </div>
      </a>
    ) : (
      <>
        <span class="feature-item-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
        <div class="feature-item-body">
          <p class="feature-item-title">{title}</p>
          <div class="feature-item-description">
            <slot />
          </div>
        </div>
      </>
    )
  }
</li>
