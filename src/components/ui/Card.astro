---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  class?: string;
}

const { title, eyebrow, href, class: className = '' } = Astro.props;

const cardClass = `card ${href ? 'card--linked' : ''} ${className}`.trim();
---

<article class={cardClass}>
  {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
  <h3 class="card-title">
    {href ? (
      <a href={href} class="card-link">
        {title}
      </a>
    ) : (
      title
    )}
  </h3>
  <div class="card-body">
    <slot />
  </div>
</article>
