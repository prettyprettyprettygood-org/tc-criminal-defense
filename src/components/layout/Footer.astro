---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner container">
    <div class="footer-col footer-col--brand">
      <a href="/" class="brand" aria-label={`Go to ${SITE.name} homepage`}>
        <span class="brand-kicker">Criminal Defense Attorney</span>
        <span class="brand-name">{SITE.shortName}</span>
      </a>
    </div>

    <div class="footer-col footer-col--center">
      <nav aria-label="Footer">
        <ul class="footer-links">
          {
            SITE.footerLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="footer-meta">&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="footer-meta">
        Built by{' '}
        <a href="https://www.prettyprettyprettygood.org/" target="_blank" rel="noopener noreferrer">
          Pretty Pretty Pretty Good
        </a>
      </p>
    </div>

    <div class="footer-col footer-col--end">
      <button type="button" class="footer-back-to-top" data-back-to-top aria-label="Back to top">
        <Icon name="arrow-up" size={18} />
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-back-to-top]');
    if (!(button instanceof HTMLElement)) return;

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
