---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import FeatureItem from '../components/ui/FeatureItem.astro';
import InfoBlock from '../components/ui/InfoBlock.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Carol I. Zacheiss, Attorney at Law | Tri-Cities Criminal Defense"
  description="Criminal defense attorney serving Hopewell, Prince George, Petersburg, Richmond, and Chesterfield, Virginia, with 34 years of experience."
>
  <section class="section hero grid-2 grid">
    <div class="stack">
      <p class="kicker">Criminal Defense Attorney &mdash; Tri-Cities, Virginia</p>
      <h1>Protecting Your Rights, Securing Your Future</h1>
      <p class="hero-copy">
        Carol I. Zacheiss has spent 34 years practicing criminal law &mdash; as a prosecutor in New
        York and Virginia, and for decades since, as defense counsel. Her practice today is devoted
        exclusively to criminal defense for clients across the Tri-Cities.
      </p>
      <div class="hero-actions">
        <Button href="/contact" variant="solid">Request a Consultation</Button>
        <Button href="/practice-areas" variant="outline">See Practice Areas</Button>
      </div>
    </div>
    <img
      src="/images/law-firm.jpg"
      alt="Bronze statue of Lady Justice holding a set of scales"
      style="border-radius: var(--radius-lg); box-shadow: var(--shadow-surface); object-fit: cover; width: 100%; height: 100%;"
    />
  </section>

  <section class="section section--dark stack">
    <ul class="feature-row feature-row--center">
      <FeatureItem title="34 Years of Experience">
        <Icon name="award" slot="icon" />
        Decades of experience, first as a prosecutor and now as defense counsel.
      </FeatureItem>
      <FeatureItem title="Tri-Cities Focused">
        <Icon name="map-pin" slot="icon" />
        Proudly serving Hopewell, Prince George, Petersburg, Richmond, and Chesterfield, Virginia.
      </FeatureItem>
      <FeatureItem title="Criminal Defense Only">
        <Icon name="scale" slot="icon" />
        A practice dedicated exclusively to criminal defense &mdash; no civil matters.
      </FeatureItem>
    </ul>
  </section>

  <section class="section stack">
    <div class="stack">
      <p class="kicker">Practice Areas</p>
      <h2>Focused criminal defense representation.</h2>
      <p class="hero-copy">
        A sample of Carol's focus areas &mdash; see the full list on the Practice Areas page.
      </p>
    </div>
    <ul class="feature-row">
      <FeatureItem title="Drug Possession & Distribution Defense" class="feature-item--framed">
        <Icon name="flask-conical" slot="icon" />
        Representation for drug possession, distribution, and related charges.
      </FeatureItem>
      <FeatureItem title="Firearms & Weapons Charges" class="feature-item--framed">
        <Icon name="shield-alert" slot="icon" />
        Defense grounded in years of experience with firearms cases from both sides of the
        courtroom.
      </FeatureItem>
      <FeatureItem title="Fourth Amendment Defense" class="feature-item--framed">
        <Icon name="search" slot="icon" />
        Challenging unlawful searches, stops, and seizures.
      </FeatureItem>
      <FeatureItem title="Criminal Record Expungement" class="feature-item--framed">
        <Icon name="eraser" slot="icon" />
        Helping eligible clients petition to clear past charges from their record.
      </FeatureItem>
    </ul>
    <div class="hero-actions hero-actions--center">
      <Button href="/practice-areas" variant="outline">View All Practice Areas</Button>
    </div>
  </section>

  <section class="section section--panel grid-2 grid">
    <div class="stack">
      <p class="kicker">About</p>
      <h2>34 years of dedicated criminal defense.</h2>
      <p class="hero-copy">
        Carol began her career as a prosecutor in Brooklyn and the Bronx, then in Richmond, before
        moving to public defense in Petersburg and the Tidewater region. That experience on both
        sides of the courtroom now shapes how she defends her clients.
      </p>
      <div class="hero-actions">
        <Button href="/about" variant="outline">Meet Carol I. Zacheiss</Button>
      </div>
    </div>
    <div class="stack">
      <InfoBlock label="Service Area">
        <span class="feature-item-icon"><Icon name="landmark" /></span>
        Hopewell, Prince George, Petersburg, Richmond, and Chesterfield, Virginia
      </InfoBlock>
      <InfoBlock label="Focus">
        <span class="feature-item-icon"><Icon name="scale" /></span>
        Criminal defense exclusively &mdash; no civil matters
      </InfoBlock>
      <InfoBlock label="Experience">
        <span class="feature-item-icon"><Icon name="award" /></span>
        34 years practicing law
      </InfoBlock>
    </div>
  </section>

  <section class="section section--frame stack">
    <span class="panel-icon"><Icon name="phone-call" /></span>
    <div>
      <p class="kicker">Get Started</p>
      <h2>Facing a criminal charge? Let's talk.</h2>
      <p class="hero-copy">
        Carol offers direct, experienced counsel for clients throughout Hopewell, Prince George,
        Petersburg, Richmond, and Chesterfield.
      </p>
    </div>
    <div class="hero-actions">
      <Button href="/contact" variant="solid">Request a Consultation</Button>
      <Button href={SITE.phoneHref} variant="outline">Call {SITE.phone}</Button>
    </div>
  </section>
</BaseLayout>
