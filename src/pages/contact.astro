---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import InfoBlock from '../components/ui/InfoBlock.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Contact | Carol I. Zacheiss, Attorney at Law"
  description="Contact Carol I. Zacheiss for criminal defense representation in Hopewell, Prince George, Petersburg, Richmond, and Chesterfield, Virginia."
>
  <section class="section stack">
    <p class="kicker">Contact</p>
    <h1>Request a consultation.</h1>
    <p class="hero-copy">Call or email to discuss your case with Carol I. Zacheiss.</p>
  </section>

  <section class="section section--panel">
    <div class="grid contact-grid">
      <div class="stack" id="contact-form">
        <div class="stack">
          <p class="kicker">Send a Message</p>
          <h2>Prefer to write? Send your details below.</h2>
          <p class="hero-copy">
            Fill out the form and Carol's office will follow up to schedule your consultation.
          </p>
        </div>

        <p class="form-success" role="status" data-form-success hidden>
          Thanks &mdash; your message has been sent. Carol's office will be in touch soon.
        </p>
        <p class="form-error" role="alert" data-form-error hidden>
          Something went wrong sending your message. Please call or email instead.
        </p>

        <form class="intake-form" method="POST" action="https://formspree.io/f/xeeybprq" data-contact-form>
          <div class="intake-form__grid">
            <label class="intake-form__field">
              <span>Full Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label class="intake-form__field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="intake-form__field intake-form__field--full">
              <span>Phone</span>
              <input type="tel" name="phone" autocomplete="tel" />
            </label>
            <label class="intake-form__field intake-form__field--full">
              <span>How can we help?</span>
              <textarea name="message" rows="5" required></textarea>
            </label>
          </div>
          <input type="hidden" name="_subject" value="New consultation request — tricitiescriminallaw.com" />
          <input
            type="text"
            name="_gotcha"
            class="visually-hidden"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <div class="hero-actions">
            <Button type="submit" variant="solid">Send Message</Button>
          </div>
        </form>
      </div>

      <div class="dark-panel stack">
        <p class="kicker">Direct Contact</p>
        <InfoBlock label="Phone" href={SITE.phoneHref}>
          <span class="inline-icon"><Icon name="phone" />{SITE.phone}</span>
        </InfoBlock>
        <InfoBlock label="Fax">
          <span class="inline-icon"><Icon name="printer" />{SITE.fax}</span>
        </InfoBlock>
        <InfoBlock label="Email" href={`mailto:${SITE.contactEmail}`}>
          <span class="inline-icon"><Icon name="mail" />{SITE.contactEmail}</span>
        </InfoBlock>
        <InfoBlock label="Service Area">
          <span class="inline-icon">
            <Icon name="landmark" />Hopewell, Prince George, Petersburg, Richmond, and Chesterfield, Virginia
          </span>
        </InfoBlock>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector('[data-contact-form]');
    const successEl = document.querySelector('[data-form-success]');
    const errorEl = document.querySelector('[data-form-error]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      errorEl?.setAttribute('hidden', '');
      const submitButton = form.querySelector('button[type="submit"]');
      submitButton?.setAttribute('disabled', 'true');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.hidden = true;
          successEl?.removeAttribute('hidden');
        } else {
          errorEl?.removeAttribute('hidden');
          submitButton?.removeAttribute('disabled');
        }
      } catch {
        errorEl?.removeAttribute('hidden');
        submitButton?.removeAttribute('disabled');
      }
    });
  </script>

  <section class="section section--frame stack">
    <span class="panel-icon"><Icon name="phone-call" /></span>
    <div>
      <p class="kicker">Prefer to Call?</p>
      <h2>Carol is ready to discuss your case.</h2>
    </div>
    <p class="hero-copy">
      Call now to speak with Carol directly about your case and get answers to your questions.
    </p>
    <div class="hero-actions">
      <Button href={SITE.phoneHref} variant="solid">Call {SITE.phone}</Button>
    </div>
  </section>
</BaseLayout>
